{
  "name": "my-org-ui",
  "private": true,
  "scripts": {
    "build": "cd static && elm make src/Main.elm --optimize --output=app.js",
    "check": "node scripts/check-boundaries.cjs && elm-format static/src static/tests --validate && cd static && elm make src/Main.elm --output=/dev/null",
    "format": "elm-format static/src static/tests --yes",
    "test": "cd static && node tests/run.cjs"
  },
  "devDependencies": {
    "elm": "0.19.1-6",
    "elm-format": "0.8.8",
    "elm-test": "0.19.1-revision17"
  }
}
